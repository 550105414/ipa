# Leave SEARCH_DEMO_MODE=true for the local sample data experience.
SEARCH_DEMO_MODE=true

# Production Supabase mode: set both values and change demo mode to false.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Sensitive customer details (set as hosted secrets; never expose client-side).
SENSITIVE_VIEW_PASSWORD=
BANK_CARD_ENCRYPTION_KEY=
LOCAL_VAULT_UNLOCK_SECRET=
# Server-only Sites dispatcher credential embedded only in short-lived pairing
# links. Configure it as a hosted secret; never prefix it with NEXT_PUBLIC_.
SITES_SIWC_BYPASS_TOKEN=
SUPABASE_ID_CARD_BUCKET=id-cards
# Server-only credential used solely after end-user RLS preflight + password
# verification. Never prefix it with NEXT_PUBLIC_ or commit a real value.
SUPABASE_SENSITIVE_SERVICE_ROLE_KEY=
