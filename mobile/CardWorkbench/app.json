{
  "expo": {
    "name": "工作台",
    "slug": "CardWorkbench",
    "version": "1.3.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cardworkbench",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.xiaoke.salesworkspace",
      "buildNumber": "8",
      "infoPlist": {
        "CFBundleDisplayName": "工作台",
        "NSFaceIDUsageDescription": "用于保护个人客户资料和待办内容。",
        "NSCameraUsageDescription": "用于在个人工作台中拍摄并上传图片。",
        "NSPhotoLibraryUsageDescription": "用于在个人工作台中选择并上传图片。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.1"
          }
        }
      ],
      "expo-sqlite",
      "expo-local-authentication",
      "./plugins/with-widget-deployment-target",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.xiaoke.salesworkspace.TodoWidget",
          "groupIdentifier": "group.com.xiaoke.salesworkspace",
          "enablePushNotifications": false,
          "widgets": [
            {
              "name": "TodoWidget",
              "displayName": "工作台待办",
              "description": "显示工作台中最新的未完成待办。",
              "contentMarginsDisabled": true,
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            }
          ]
        }
      ],
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
