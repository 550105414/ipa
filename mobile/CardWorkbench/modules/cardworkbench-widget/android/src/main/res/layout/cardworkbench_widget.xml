<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/cardworkbench_widget_root"
  android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:padding="16dp"
  android:background="@drawable/cardworkbench_widget_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="36dp"
    android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:layout_width="24dp" android:layout_height="24dp"
      android:src="@drawable/cardworkbench_widget_list" android:importantForAccessibility="no" />
    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
      android:layout_marginStart="8dp" android:text="全部" android:textSize="22sp"
      android:textStyle="bold" android:fontFamily="sans-serif" android:textColor="#3B78B9"
      android:singleLine="true" android:includeFontPadding="false" />
    <TextView android:id="@+id/cardworkbench_widget_count"
      android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="30dp" android:minWidth="34dp"
      android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:gravity="center"
      android:background="@drawable/cardworkbench_widget_count_background"
      android:text="0" android:textSize="16sp" android:textStyle="bold" android:textColor="#202124"
      android:fontFamily="sans-serif" android:includeFontPadding="false" />
  </LinearLayout>
  <LinearLayout android:id="@+id/cardworkbench_widget_rows"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="6dp" android:orientation="vertical" />
  <TextView android:id="@+id/cardworkbench_widget_empty"
    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:gravity="center_vertical" android:text="打开工作台同步待办"
    android:textColor="#8793A2" android:textSize="14sp" android:fontFamily="sans-serif"
    android:includeFontPadding="false" android:maxLines="3" android:ellipsize="end" />
  <TextView android:id="@+id/cardworkbench_widget_footer"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="6dp" android:text="点击打开工作台" android:textColor="#98A1AD"
    android:textSize="11sp" android:fontFamily="sans-serif" android:singleLine="true"
    android:includeFontPadding="false" android:ellipsize="end" />
</LinearLayout>
